# Local origin port exposed through Cloudflare Tunnel.
AI_SERVER_HOST_PORT=8088
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Relative to /mnt/data/openresist/ai-server/models.
# Use scripts/select-model.sh after downloading a GGUF to set this safely.
LLAMA_MODEL_FILE=llama-4-scout/model.gguf
LLAMA_MODEL_ALIAS=llama-4-scout

# Required for public exposure. Clients use: Authorization: Bearer <LLAMA_API_KEY>
LLAMA_API_KEY=change-me-bootstrap-will-generate-a-random-token

# CPU-only defaults tuned for a busy 128 GB RAM host. Increase context after confirming RAM headroom.
LLAMA_CTX_SIZE=4096
LLAMA_THREADS=0
LLAMA_PARALLEL=1
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=128
LLAMA_CACHE_TYPE_K=q4_0
LLAMA_CACHE_TYPE_V=q4_0

# Leave mmap enabled for large CPU models unless you have a reason to force full locking.
LLAMA_MLOCK=false
LLAMA_NO_MMAP=false

# Optional extra llama-server flags, for example: --verbose --metrics
LLAMA_EXTRA_ARGS=

# Download helper defaults. Override these if the exact Hugging Face repo or filename changes.
MINIMAX_REPO=unsloth/MiniMax-M2.7-GGUF
MINIMAX_PATTERN=*UD-IQ4_XS*.gguf
LLAMA_SCOUT_REPO=unsloth/Llama-4-Scout-17B-16E-Instruct-GGUF
LLAMA_SCOUT_PATTERN=UD-Q4_K_XL/*.gguf*
