AI_IMAGINE_HOST_BIND=0.0.0.0
AI_IMAGINE_HOST_PORT=8090

# Local CPU build of stable-diffusion.cpp. The public GHCR package currently
# publishes backend-specific tags, so this service builds a CPU image locally.
SDCPP_IMAGE=nostria-ai-imagine:stable-diffusion-cpp
SDCPP_REF=master

# Default FLUX.1 schnell wiring. scripts/bootstrap.sh can symlink these files from
# the previous ai-image-server model store if they already exist on this machine.
SDCPP_MODEL_ARGS="--diffusion-model /models/diffusion_models/flux1-schnell.safetensors --vae /models/vae/ae.safetensors --clip_l /models/text_encoders/clip_l.safetensors --t5xxl /models/text_encoders/t5xxl_fp8_e4m3fn.safetensors"

# CPU-oriented defaults for this host. Tune threads after watching real generation load.
SDCPP_RUNTIME_ARGS="--threads 10 --mmap --clip-on-cpu --vae-on-cpu --offload-to-cpu --lora-model-dir /models/loras --hires-upscalers-dir /models/upscalers"
SDCPP_DEFAULT_ARGS="--cfg-scale 1.0 --sampling-method euler --steps 4 -W 1024 -H 1024 -v"
SDCPP_EXTRA_ARGS=""
SDCPP_MODEL_PRESET=flux1-schnell

# Optional Hugging Face token for gated downloads. Prefer exporting HF_TOKEN in the
# shell instead of storing it here if possible.
HF_TOKEN=""

FLUX1_SCHNELL_REPO=black-forest-labs/FLUX.1-schnell
FLUX1_SCHNELL_GGUF_REPO=leejet/FLUX.1-schnell-gguf
FLUX1_DEV_REPO=black-forest-labs/FLUX.1-dev
FLUX1_DEV_GGUF_REPO=leejet/FLUX.1-dev-gguf
FLUX1_KONTEXT_GGUF_REPO=QuantStack/FLUX.1-Kontext-dev-GGUF
FLUX_TEXT_ENCODERS_REPO=comfyanonymous/flux_text_encoders
Z_IMAGE_TURBO_GGUF_REPO=leejet/Z-Image-Turbo-GGUF
Z_IMAGE_BASE_GGUF_REPO=unsloth/Z-Image-GGUF
QWEN3_4B_INSTRUCT_GGUF_REPO=unsloth/Qwen3-4B-Instruct-2507-GGUF
FLUX2_DEV_REPO=black-forest-labs/FLUX.2-dev
FLUX2_DEV_GGUF_REPO=city96/FLUX.2-dev-gguf
FLUX2_KLEIN_4B_GGUF_REPO=leejet/FLUX.2-klein-4B-GGUF
FLUX2_KLEIN_BASE_4B_GGUF_REPO=leejet/FLUX.2-klein-base-4B-GGUF
QWEN3_4B_GGUF_REPO=unsloth/Qwen3-4B-GGUF
MISTRAL_SMALL_32_24B_GGUF_REPO=unsloth/Mistral-Small-3.2-24B-Instruct-2506-GGUF
QWEN_IMAGE_GGUF_REPO=QuantStack/Qwen-Image-GGUF
QWEN_IMAGE_EDIT_GGUF_REPO=QuantStack/Qwen-Image-Edit-GGUF
QWEN_IMAGE_EDIT_2509_GGUF_REPO=QuantStack/Qwen-Image-Edit-2509-GGUF
QWEN_IMAGE_COMFY_REPO=Comfy-Org/Qwen-Image_ComfyUI
QWEN25_VL_7B_GGUF_REPO=mradermacher/Qwen2.5-VL-7B-Instruct-GGUF
CHROMA_GGUF_REPO=silveroxides/Chroma-GGUF
ERNIE_IMAGE_TURBO_GGUF_REPO=unsloth/ERNIE-Image-Turbo-GGUF
MINISTRAL_33B_GGUF_REPO=unsloth/Ministral-3-3B-Instruct-2512-GGUF
