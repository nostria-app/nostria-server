ARG PYTORCH_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
FROM ${PYTORCH_IMAGE}

ARG COMFYUI_REF=master
ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git clone https://github.com/comfyanonymous/ComfyUI.git ComfyUI \
    && cd ComfyUI \
    && git checkout "$COMFYUI_REF" \
    && pip install -r requirements.txt

COPY config/start-comfyui.sh /usr/local/bin/nostria-start-comfyui
RUN chmod +x /usr/local/bin/nostria-start-comfyui

WORKDIR /app/ComfyUI
ENTRYPOINT ["/usr/local/bin/nostria-start-comfyui"]