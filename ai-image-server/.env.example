# Local API gateway port exposed through Cloudflare Tunnel.
AI_IMAGE_SERVER_HOST_PORT=8090

# Required for public exposure. Clients use: Authorization: Bearer <IMAGE_API_KEY>
IMAGE_API_KEY=change-me-bootstrap-will-generate-a-random-token

# ComfyUI container build/runtime settings.
PYTORCH_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
COMFYUI_REF=master
# This host currently runs without an NVIDIA driver. Remove --cpu after enabling GPU access.
COMFYUI_EXTRA_ARGS=--cpu

# NVIDIA settings are harmless in the environment, but Docker GPU access still requires
# enabling `gpus: all` in docker-compose.yml and installing NVIDIA Container Toolkit.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Download helper defaults. Override these if model repositories or file layouts change.
# Optional Hugging Face token for gated models such as FLUX.1 schnell and FLUX.2.
HF_TOKEN=

Z_IMAGE_REPO=Tongyi-MAI/Z-Image-Turbo
Z_IMAGE_PATTERN=*.safetensors

FLUX1_SCHNELL_REPO=black-forest-labs/FLUX.1-schnell
FLUX1_SCHNELL_PATTERN=*.safetensors

# FLUX.2 klein 4B distilled repository. Requires approved Hugging Face access.
FLUX2_KLEIN_REPO=black-forest-labs/FLUX.2-klein-4B
FLUX2_KLEIN_PATTERN=*.safetensors